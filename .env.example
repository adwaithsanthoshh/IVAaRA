# ==============================================================
# IVaaRA — Intra Venous Automation and Response Architecture
# Environment Configuration
# ==============================================================

# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────
# SQLite (default for local/hackathon)
DATABASE_URL=sqlite+aiosqlite:///./ivara.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql+asyncpg://ivara:password@localhost:5432/ivara

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=ivara-backend
MQTT_KEEPALIVE=60

# ── CORS / Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Device Settings ───────────────────────────────────────────
# Time in seconds before a device is marked OFFLINE
DEVICE_OFFLINE_TIMEOUT=30
# Maximum telemetry records to keep per device (0 = unlimited)
TELEMETRY_MAX_RECORDS=10000
# Telemetry publish interval expected from ESP32 (seconds)
TELEMETRY_INTERVAL=5

# ── Risk Engine ───────────────────────────────────────────────
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MODERATE=60
RISK_THRESHOLD_HIGH=80

# ── Telegram Alerts (optional) ────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Groq AI (key failover: tries KEY_1 → KEY_2 → KEY_3, falls back only when all fail)
# Get your key(s) at: https://console.groq.com
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=15
GROQ_MAX_TOKENS=512
# Min seconds between AI analyses per device (prevents spam)
GROQ_AI_COOLDOWN=30
